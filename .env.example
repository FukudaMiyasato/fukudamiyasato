# Copia este archivo a .env.local para probar la función con `vercel dev`.
# En producción estas mismas variables van en:
#   Vercel → tu proyecto → Settings → Environment Variables
#
# .env.local está en .gitignore: nunca subas el token al repo.

# Airtable Personal Access Token, scope `data.records:read`,
# con acceso solo a esta base. Créalo en:
#   https://airtable.com/create/tokens
AIRTABLE_TOKEN=pat...

# Opcionales — solo si cambias de base, tabla o vista.
# AIRTABLE_BASE=appU39PYosvxt8FfG
# AIRTABLE_TABLE=tblYmNMjQai8IJeeL
# AIRTABLE_VIEW=viwoFafbiplokrhWt

# Segundos que el CDN de Vercel cachea la respuesta. 0 = siempre fresco.
# WORKS_CACHE_SECONDS=30
