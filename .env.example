# Copia este archivo a .env.local para probar la función con `vercel dev`.
# En producción estas mismas variables van en:
#   Vercel → tu proyecto → Settings → Environment Variables
#
# .env.local está en .gitignore: nunca subas el token al repo.

# Airtable Personal Access Token, scope `data.records:read`,
# con acceso solo a esta base. Créalo en:
#   https://airtable.com/create/tokens
AIRTABLE_TOKEN=pat...

# Opcionales — solo si cambias de base, tabla o vista.
# AIRTABLE_BASE=appU39PYosvxt8FfG
# AIRTABLE_TABLE=tblYmNMjQai8IJeeL
# AIRTABLE_VIEW=viwoFafbiplokrhWt

# Segundos que el CDN de Vercel cachea la respuesta. 0 = siempre fresco.
# WORKS_CACHE_SECONDS=30

# --- api/ia.js -------------------------------------------------------

# Secreto del webhook de voz (POST /api/ia). Genera uno con:
#   openssl rand -hex 24
INDEX_AUT=...

# Key de OpenAI, para generar las mini-apps.
OPENAI_API_KEY=sk-...

# Opcional — por defecto gpt-4o.
# OPENAI_MODEL=gpt-4o

# Clave de /test/sendOrder/ (manda texto como si fuera el webhook, sin
# exponer INDEX_AUT en el navegador). Otro secreto random, distinto del
# de arriba:
#   openssl rand -hex 24
TEST_ORDER_KEY=...

# --- api/auth.js + api/perms.js (login con Google y panel /admin) -----

# OAuth Client ID tipo "Web application" de Google Cloud. En
# "Authorized JavaScript origins" agrega tu dominio (https://...) y
# http://localhost:3000 para `vercel dev`.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Firma la cookie de sesión. Genera uno con:
#   openssl rand -hex 32
SESSION_SECRET=...

# Opcional.
# ADMIN_EMAIL=fukuda.miyasato@gmail.com

# Base de datos de permisos, dashboards y widgets: Upstash Redis.
# En Vercel → Storage → Upstash for Redis se agregan solas al conectarla.
# Para `vercel dev`, cópialas con `npx vercel env pull .env.local`.
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
